---
layout: base.njk
---
{% set cat = taxonomy.categories | findCategory(category) %}
{% set postAudience = audience or (cat.audience if cat else 'ihr') %}
{% set postInquiry = inquiry or (cat.inquiry if cat else 'hochzeit') %}
<article>
  <header class="hero hero--article">
    {% if featured %}
    <img class="hero__image"
         src="{{ featured.url | unsplash(1600) }}"
         srcset="{{ featured.url | unsplash(800) }} 800w, {{ featured.url | unsplash(1200) }} 1200w, {{ featured.url | unsplash(1600) }} 1600w, {{ featured.url | unsplash(2200) }} 2200w"
         sizes="100vw"
         width="{{ featured.width }}" height="{{ featured.height }}"
         alt="{{ featured.alt }}" fetchpriority="high">
    {% endif %}
    <div class="hero__inner">
      <nav class="breadcrumb" aria-label="Brotkrumen">
        <a href="/">Blog</a>
        {% if cat %}<span aria-hidden="true">/</span> <a href="/kategorie/{{ cat.slug }}/">{{ cat.name }}</a>{% endif %}
      </nav>
      {% if cat %}<a class="pill" href="/kategorie/{{ cat.slug }}/">{{ cat.name }}</a>{% endif %}
      <h1 class="hero__title hero__title--article">{{ title }}</h1>
      {% if subtitle %}<p class="hero__subline hero__subline--article">{{ subtitle }}</p>{% endif %}
      <p class="hero__meta">
        <time datetime="{{ date | isoDate }}">{{ date | dateDe }}</time>
        <span aria-hidden="true">|</span>
        {{ content | readingMinutes }} Min. Lesezeit
      </p>
    </div>
    {% if featured %}
    <p class="hero__credit">Foto: <a href="{{ featured.photographerUrl | utm }}" target="_blank" rel="noopener">{{ featured.photographer }}</a> auf <a href="{{ '' | utm }}" target="_blank" rel="noopener">Unsplash</a></p>
    {% endif %}
  </header>

  <div class="section section--cream">
    <div class="prose">
      {{ content | safe }}
    </div>
  </div>

  {% if faq and faq.length %}
    {% include "partials/faq.njk" %}
  {% endif %}

  {% if site.ai_note.enabled %}
  <div class="section section--cream section--note">
    <p class="ai-note">{{ site.ai_note.text }}</p>
  </div>
  {% endif %}
</article>

{% include "partials/cta.njk" %}
