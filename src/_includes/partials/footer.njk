<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <img src="{{ site.logo.src }}" width="{{ site.logo.width }}" height="{{ site.logo.height }}" alt="{{ site.logo.alt }}" loading="lazy">
      <p>{{ site.footer_tagline }}</p>
      <a class="site-footer__main-link" href="{{ site.main_site }}">Zu djmostar.de</a>
    </div>
    <div class="site-footer__contact">
      <h2>Kontakte</h2>
      {% set iconName = "mail" %}<a class="site-footer__line" href="mailto:{{ site.contact.email }}">{% include "partials/icon.njk" %}{{ site.contact.email }}</a>
      {% set iconName = "phone" %}<a class="site-footer__line" href="tel:{{ site.contact.phone_e164 }}">{% include "partials/icon.njk" %}{{ site.contact.phone_display }}</a>
      <div class="social">
        {% for item in site.social %}{% set iconName = item.icon %}<a href="{{ item.url }}" target="_blank" rel="noopener" aria-label="{{ item.label }}">{% include "partials/icon.njk" %}</a>{% endfor %}
      </div>
    </div>
  </div>
  <div class="site-footer__bottom">
    <p>© DJ MOSTAR</p>
    <a href="{{ site.legal_url }}">Impressum/Datenschutz</a>
  </div>
</footer>
