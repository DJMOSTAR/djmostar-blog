{# Expects: post (an Eleventy collection item), lead (true for the large first card) #}
{% set postCategory = taxonomy.categories | findCategory(post.data.category) %}
<article class="card{{ ' card--lead' if lead else '' }}">
  {% if post.data.featured %}
  <figure class="card__media">
    <a href="{{ post.url }}" tabindex="-1" aria-hidden="true">
      <img src="{{ post.data.featured.url | unsplash(1000 if lead else 640) }}"
           srcset="{{ post.data.featured.url | unsplash(480) }} 480w, {{ post.data.featured.url | unsplash(800) }} 800w, {{ post.data.featured.url | unsplash(1200) }} 1200w"
           sizes="{{ '(min-width: 900px) 60vw, 100vw' if lead else '(min-width: 900px) 30vw, (min-width: 600px) 50vw, 100vw' }}"
           width="{{ post.data.featured.width }}" height="{{ post.data.featured.height }}"
           alt="{{ post.data.featured.alt }}" loading="{{ 'eager' if lead else 'lazy' }}">
    </a>
    <figcaption>Foto: <a href="{{ post.data.featured.photographerUrl | utm }}" target="_blank" rel="noopener">{{ post.data.featured.photographer }}</a> auf <a href="{{ '' | utm }}" target="_blank" rel="noopener">Unsplash</a></figcaption>
  </figure>
  {% endif %}
  <div class="card__body">
    {% if postCategory %}<a class="pill" href="/kategorie/{{ postCategory.slug }}/">{{ postCategory.name }}</a>{% endif %}
    <h3 class="card__title"><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
    <p class="card__excerpt">{{ post.data.excerpt }}</p>
    <a class="card__more" href="{{ post.url }}" aria-label="Weiterlesen: {{ post.data.title }}">Weiterlesen →</a>
  </div>
</article>
